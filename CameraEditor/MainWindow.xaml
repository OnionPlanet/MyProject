<Window
    x:Class="CameraEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CameraEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="相机配置编辑器"
    Width="400"
    Height="550"
    d:DataContext="{d:DesignInstance Type=local:CameraEditorViewModel}"
    FontSize="16"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <StackPanel Margin="24">

        <TextBlock
            Margin="0,0,0,16"
            FontSize="24"
            FontWeight="SemiBold"
            Text="相机曝光设置" />

        <ListBox
            x:Name="CameraList"
            Height="120"
            Margin="0,0,0,16"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            ItemsSource="{Binding Cameras}"
            SelectedItem="{Binding SelectedCamera, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4" Orientation="Horizontal">
                        <TextBlock Width="80" Text="{Binding Name}" />
                        <TextBlock Text="曝光时间" />
                        <TextBlock Width="90" Text="{Binding ExposureTime}" />
                        <TextBlock Text="曝光上限" />
                        <TextBlock Width="90" Text="{Binding MaxMicroseconds}" />
                        <TextBlock Text="微秒" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button
            x:Name="AddCamera"
            Padding="10,6"
            HorizontalAlignment="Left"
            Command="{Binding AddCameraCommand}"
            Content="添加备用相机" />
        <Button
            x:Name="RemoveCamera"
            Padding="10,6"
            HorizontalAlignment="Left"
            Command="{Binding RemoveCameraCommand}"
            Content="删除相机" />

        <TextBlock
            x:Name="CameraInfoText"
            Margin="0,0,0,8"
            Text="{Binding SelectedCamera.Name}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="CurrentExposureText"
            Margin="0,0,0,20"
            Text="{Binding SelectedCamera.ExposureTime}" />

        <TextBlock Margin="0,0,0,8" Text="新的曝光时间（微秒）" />

        <TextBox
            x:Name="ExposureInput"
            Margin="0,0,0,12"
            Padding="8"
            Text="{Binding ExposureTimeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Grid>
            <Button
                x:Name="ChangeExposure"
                Margin="0,0,0,12"
                Padding="16,8"
                HorizontalAlignment="Left"
                Command="{Binding ApplyExposureCommand}"
                Content="修改曝光" />

            <Button
                x:Name="RestExposure"
                Margin="0,0,0,12"
                Padding="16,8"
                HorizontalAlignment="Right"
                Command="{Binding RestExposureInputCommand}"
                Content="恢复曝光" />
        </Grid>
        <Button
            Margin="0,0,0,12"
            Padding="16,8"
            HorizontalAlignment="Left"
            Command="{Binding SaveCamerasCommand}"
            Content="保存配置" />
        <TextBlock
            x:Name="StatusText"
            MinHeight="40"
            Text="{Binding StatusMessage}"
            TextWrapping="Wrap" />

    </StackPanel>
</Window>