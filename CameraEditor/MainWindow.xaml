<Window x:Class="CameraEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相机曝光设置"
        Width="460"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FontSize="16">

    <StackPanel Margin="24">

        <TextBlock Text="相机曝光设置"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <ListBox x:Name="CameraList"
                 ItemsSource="{Binding Cameras}"
                 SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                 Height="120"
                 Margin="0,0,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin ="4">
                        <TextBlock Text="{Binding Name}" Width="80"/>
                        <TextBlock Text="曝光时间"/>
                        <TextBlock Text = "{Binding ExposureTime}" Width="90"/>
                        <TextBlock Text="曝光上限"/>
                        <TextBlock Text="{Binding MaxMicroseconds}" Width="90"/>
                        <TextBlock Text="微秒"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="AddCamera"
                Content ="添加备用相机"
                Click="AddCamera_Click"
                Padding="10,6"
                HorizontalAlignment="Left"
            />
        <Button x:Name="RemoveCamera"
                Padding="10,6"
                Click="RemoveCamera_Click"
            Content="删除相机"
            HorizontalAlignment="Left"
            />

        <TextBlock x:Name="CameraInfoText"
                   Text="{Binding Name}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="CurrentExposureText"
                   Text="{Binding ExposureTime}"
                   Margin="0,0,0,20" />

        <TextBlock Text="新的曝光时间（微秒）"
                   Margin="0,0,0,8" />

        <TextBox x:Name="ExposureInput"
                 Padding="8"
                 Margin="0,0,0,12" />

        <Button Content="修改曝光"
                x:Name="ChangeExposure"
                HorizontalAlignment="Left"
                Padding="16,8"
                Margin="0,0,0,12" />

        <TextBlock x:Name="StatusText"
                   TextWrapping="Wrap"
                   MinHeight="40" />

    </StackPanel>
</Window>